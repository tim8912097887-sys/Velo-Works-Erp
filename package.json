{
  "name": "velo_works_erp",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.26.0"
  },
  "main": "index.js",
  "scripts": {
    "packages:build": "pnpm --filter \"@app/*\" -r run build",
    "packages:install": "pnpm --filter \"@app/*\" -r install",
    "packages:lint": "pnpm --filter \"@app/*\" -r run lint",
    "packages:lint:fix": "pnpm --filter \"@app/*\" -r run lint:fix",
    "services:install": "pnpm --filter \"./services/*\" -r install",
    "services:build": "pnpm --filter \"./services/*\" -r run build",
    "services:lint": "pnpm --filter \"./services/*\" -r run lint",
    "services:lint:fix": "pnpm --filter \"./services/*\" -r run lint:fix",
    "engineer-service:db:generate": "pnpm --filter \"./services/engineer-service\" run prisma:generate",
    "engineer-service:db:migrate": "pnpm --filter \"./services/engineer-service\" run prisma:migrate",
    "engineer-service:db:deploy": "pnpm --filter \"./services/engineer-service\" run prisma:deploy",
    "engineer-service:test:api": "pnpm --filter \"./services/engineer-service\" run test:api",
    "engineer-service:test": "pnpm --filter \"./services/engineer-service\" run test",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.1",
  "dependencies": {
    "husky": "catalog:"
  }
}
