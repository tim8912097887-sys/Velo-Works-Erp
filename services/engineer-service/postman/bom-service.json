      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.variables.set('expectedStatus', 201);", "pm.variables.unset('expectedError');"]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status matches expectation', function () { pm.response.to.have.status(Number(pm.variables.get('expectedStatus'))); });",
          "const expectedError = pm.variables.get('expectedError');",
          "if (expectedError) pm.test('Expected error code is returned', function () { const json = pm.response.json(); pm.expect(json.state).to.eql('error'); pm.expect(json.error.code).to.eql(expectedError); });"
        ]
      }
    }
  ],
