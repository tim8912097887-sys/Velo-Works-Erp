// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ==========================================
// Items
// ==========================================

model Item {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  itemCode      String   @unique @map("item_code") @db.VarChar(50)
  name          String   @db.NVarChar(200)

  // FINISHED_GOOD / SUBASSEMBLY / RAW_MATERIAL
  itemType      String   @map("item_type") @db.VarChar(30)

  unitOfMeasure String   @map("unit_of_measure") @db.VarChar(20)

  // MAKE / BUY / BOTH
  makeBuy       String   @map("make_buy") @db.VarChar(20)

  leadTimeDays  Int      @default(0) @map("lead_time_days")
  safetyStock   Decimal  @default(0) @map("safety_stock") @db.Decimal(18, 3)

  // Added for optimistic locking
  version       Int      @default(1) @db.Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime2
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime2

  // An item can be a parent in multiple BOM revisions.
  bomHeaders    BomHeader[] @relation("ParentItem")

  // An item can be a component in multiple BOMs.
  bomComponents BomComponent[] @relation("ComponentItem")

  // An item can have multiple routing revisions.
  routings      Routing[]

  @@index([itemType, active])
  @@map("items")
}

// ==========================================
// BOM Headers
// ==========================================

model BomHeader {
  id           String   @id @default(uuid()) @db.UniqueIdentifier

  parentItemId String   @map("parent_item_id") @db.UniqueIdentifier

  revision     String   @db.VarChar(20)

  // DRAFT / ACTIVE / OBSOLETE
  status       String   @db.VarChar(20)

  // Added for optimistic locking
  version       Int      @default(1) @db.Int

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime2

  parentItem   Item @relation("ParentItem", fields: [parentItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  components   BomComponent[]

  @@unique([parentItemId, revision])
  @@index([parentItemId, status])
  @@map("bom_headers")
}

// ==========================================
// BOM Components
// ==========================================

model BomComponent {
  id              String  @id @default(uuid()) @db.UniqueIdentifier

  bomHeaderId     String  @map("bom_header_id") @db.UniqueIdentifier
  componentItemId String  @map("component_item_id") @db.UniqueIdentifier

  componentRevision String? @map("component_revision")

  quantityPer     Decimal @map("quantity_per") @db.Decimal(18, 6)
  scrapRate       Decimal @default(0) @map("scrap_rate") @db.Decimal(9, 6)

  operationSeq    Int?    @map("operation_seq")

  bomHeader       BomHeader @relation(fields: [bomHeaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  componentItem   Item @relation("ComponentItem", fields: [componentItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bomHeaderId])
  @@index([componentItemId])
  @@map("bom_components")
}

// ==========================================
// Routings
// ==========================================

model Routing {
  id        String   @id @default(uuid()) @db.UniqueIdentifier

  itemId    String   @map("item_id") @db.UniqueIdentifier
  revision  String   @db.VarChar(20)

  // DRAFT / ACTIVE / OBSOLETE
  status    String   @db.VarChar(20)

  item      Item @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  operations RoutingOperation[]

  @@unique([itemId, revision])
  @@index([itemId, status])
  @@map("routings")
}

// ==========================================
// Routing Operations
// ==========================================

model RoutingOperation {
  id              String  @id @default(uuid()) @db.UniqueIdentifier

  routingId       String  @map("routing_id") @db.UniqueIdentifier

  operationSeq    Int     @map("operation_seq")

  // Reference to work center.
  // If work centers belong to another microservice,
  // do not create a cross-database foreign key.
  workCenterId    String  @map("work_center_id") @db.UniqueIdentifier

  setupMinutes    Decimal @default(0) @map("setup_minutes") @db.Decimal(10, 2)

  runMinutesPerUnit Decimal @map("run_minutes_per_unit") @db.Decimal(10, 4)

  routing         Routing @relation(fields: [routingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([routingId, operationSeq])
  @@index([workCenterId])
  @@map("routing_operations")
}
